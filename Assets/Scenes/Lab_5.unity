  textMesh: {fileID: 120091548}
  textBackground: {fileID: 795643620}
  typingSpeed: 0.05
  dialogueLines:
  - text: What are you doing here?
    isPlayer: 1
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: What are you doing here?
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "I wouldn\u2019t linger here alone if I were you."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "This part of the lab\u2026 it isn\u2019t stable. Floors give way, machines\u2026
      bite. Heh."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "Strange things creep in when you\u2019re by yourself."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "Strange things creep in when you\u2019re by yourself."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "Stay sharp, little paws. I\u2019ll be close if you\u2026 need me."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
