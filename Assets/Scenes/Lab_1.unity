  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3da1d7868d30fc348a62d74bda06fdef, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  font: {fileID: 12800000, guid: 48e8809a319f6e54aa435df9fec61e1a, type: 3}
  fontSize: 64
  characterSize: 0.1
  sortingOrder: 1669
  sortingLayerName: Default
  originPos1:
    slot: 0
    localOffset: {x: -0.35, y: 1, z: 0}
    baseDirection: {x: 0.22, y: 0.55}
    waveAmplitude: 0.12
    waveFrequency: 2
    wavePhase: 0
    startScale: 0.75
    peakScale: 1.12
    duration: 1.6
    color: {r: 1, g: 1, b: 1, a: 1}
  originPos2:
    slot: 1
    localOffset: {x: 0.35, y: 0.85, z: 0}
    baseDirection: {x: -0.2, y: 0.6}
    waveAmplitude: 0.12
    waveFrequency: 2
    wavePhase: 0
    startScale: 0.75
    peakScale: 1.12
    duration: 1.6
    color: {r: 1, g: 1, b: 1, a: 1}
  events:
  - timeFromStart: 9
    text: 'Sorry to wake you up,

      fat, strange looking one.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 0
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0
    waveFrequency: 0
    wavePhase: 0
    startScale: 0
    peakScale: 0
  - timeFromStart: 17
    text: 'You''ve got red and grey bits

      lying round, looks fun.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 0
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0
    waveFrequency: 0
    wavePhase: 0.7
    startScale: 0
    peakScale: 0
  - timeFromStart: 27
    text: 'Tempting, sure,

      but a bit too tough.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 0
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0
    waveFrequency: 0
    wavePhase: 1.4
    startScale: 0
    peakScale: 0
  - timeFromStart: 31
    text: 'Tried to chew one,

      wasn''t soft enough.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 0
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0
    waveFrequency: 0
    wavePhase: 2.1
    startScale: 0
    peakScale: 0
  - timeFromStart: 36
    text: 'You ate my button,

      you fur-brained fool.'
    origin: 1
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2.1
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0.2
    waveFrequency: 2.8
    wavePhase: 0.4
    startScale: 0
    peakScale: 1.28
  - timeFromStart: 39
    text: 'You left it lying down,

      looking cool.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 0
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0
    waveFrequency: 0
    wavePhase: 2.8
    startScale: 0
    peakScale: 0
  - timeFromStart: 44
    text: 'Not cool.

      It''s a quantum flux.'
    origin: 1
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0.16
    waveFrequency: 2.2
    wavePhase: 1
    startScale: 0
    peakScale: 1.18
  - timeFromStart: 49
    text: 'Guess I''ll need

      nine lives for luck.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 1.9
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0.14
    waveFrequency: 2
    wavePhase: 3.5
    startScale: 0
    peakScale: 0
  - timeFromStart: 59
    text: 'Any way out,

      any door that''s kind.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2.3
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0.1
    waveFrequency: 1.6
    wavePhase: 4.2
    startScale: 0
    peakScale: 1.14
  - timeFromStart: 71
    text: 'This place hums wrong,

      like it''s losing its mind.'
    origin: 0
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2.6
    baseDirection: {x: 0.18, y: 0.42}
    waveAmplitude: 0.08
    waveFrequency: 1.3
    wavePhase: 4.9
    startScale: 0
    peakScale: 1.1
  - timeFromStart: 85
    text: 'Maybe one piston door

      down the hall.'
    origin: 1
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2.2
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0.14
    waveFrequency: 1.8
    wavePhase: 2
    startScale: 0
    peakScale: 1.18
  - timeFromStart: 91
    text: 'Half alive,

      half rust,

      half wall.'
    origin: 1
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2.4
    baseDirection: {x: 0, y: 0}
    waveAmplitude: 0.12
    waveFrequency: 1.5
    wavePhase: 2.7
    startScale: 0
    peakScale: 1.2
  - timeFromStart: 94
    text: 'Keep still.

      I''ll wake it slow.'
    origin: 1
    useOriginDefaults: 1
    color: {r: 1, g: 1, b: 1, a: 0}
    duration: 2.7
    baseDirection: {x: -0.12, y: 0.38}
    waveAmplitude: 0.06
    waveFrequency: 1
    wavePhase: 3.4
    startScale: 0
    peakScale: 1.1
