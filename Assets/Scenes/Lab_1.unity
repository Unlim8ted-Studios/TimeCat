  m_Name: 
  m_EditorClassIdentifier: 
  textMesh: {fileID: 766737822}
  textBackground: {fileID: 2061117557}
  typingSpeed: 0.05
  dialogueLines:
  - text: Sorry, I didn't mean to wake you.
    isPlayer: 1
    onEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1990583213}
          m_TargetAssemblyTypeName: UnityEngine.Behaviour, UnityEngine
          m_MethodName: set_enabled
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 1
          m_CallState: 2
        - m_Target: {fileID: 1990583214}
          m_TargetAssemblyTypeName: CatPlayerController, Assembly-CSharp
          m_MethodName: sit
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 1
  - text: "No its fine, I haven't seen \nanother in ages."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: 'By chance did you see a button out

      there? I may have been supposed

      to
      guard one...'
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: 'Oh, umm, I may have eaten it.

      Was it important?'
    isPlayer: 1
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: 'What?? Why would you eat it????

      That button allowed traveling

      through
      time.'
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "Maybe its still usable? \nOnly time will tell. How\ndid you get here anyway?"
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: 'Its kind of a long story.

      Is there any way out

      of here?'
    isPlayer: 1
    onEvent:
      m_PersistentCalls:
        m_Calls: []
    triggerEventBeforeLine: 0
    triggerEventAfterPressingContinue: 0
  - text: "Here let me open up the \ndoor to the lower levels. \nThere might be an
      exit\nfurther on in the laboratory."
    isPlayer: 0
    onEvent:
      m_PersistentCalls:
        m_Calls:
        - m_Target: {fileID: 1007660175}
          m_TargetAssemblyTypeName: PistonMover, Assembly-CSharp
          m_MethodName: EnablePiston
          m_Mode: 1
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
            m_IntArgument: 0
            m_FloatArgument: 0
            m_StringArgument: 
            m_BoolArgument: 0
          m_CallState: 2
        - m_Target: {fileID: 1697141948}
          m_TargetAssemblyTypeName: UnityEngine.GameObject, UnityEngine
          m_MethodName: SetActive
          m_Mode: 6
          m_Arguments:
            m_ObjectArgument: {fileID: 0}
            m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
